# ---- Base de datos ----
# SQLite local (relativa a la carpeta prisma/). Para Vercel usa una base remota (Postgres, Turso...).
DATABASE_URL="file:./dev.db"

# ---- Licencia CONTROL (https://github.com/cajacuenta767-sketch/CONTROL) ----
# Todo esto también se puede escribir desde la pantalla "Licencia" del sistema.
# URL del panel CONTROL de la agencia. Sin esta variable y en desarrollo, el sistema funciona sin licencia.
CONTROL_URL=
# Clave de licencia entregada al cliente (CTL-XXXX-XXXX-XXXX-XXXX)
CONTROL_LICENCIA=
# Clave pública Ed25519 de CONTROL (base64 de 32 bytes, GET /api/v1/licencias/clave-publica).
# Si se deja vacía, se obtiene y se fija automáticamente en la primera activación.
CONTROL_CLAVE_PUBLICA=
# Huella para instalaciones web: dominio del cliente (si no, se usa el nombre del equipo)
CONTROL_DOMINIO=

# ---- Sesión ----
# Secreto para firmar la cookie de sesión. Si falta, se genera y guarda en data/secreto.json
# (obligatorio definirlo en Vercel/serverless, donde el disco no persiste). Genera uno: openssl rand -base64 48
SESSION_SECRET=

# Carpeta donde se guardan licencia.json y secreto.json (por defecto ./data)
FARMASYS_DATA_DIR=

# Base de los enlaces de descarga que muestra la web (instalador Windows y APK)
NEXT_PUBLIC_DESCARGAS_URL=https://github.com/cajacuenta767-sketch/Farmasys-/releases/latest/download

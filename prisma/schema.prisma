// Sistema de Farmacias - Esquema de base de datos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// USUARIOS DEL SISTEMA (roles: ADMIN, FARMACEUTICO, VENDEDOR)
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("VENDEDOR") // ADMIN | FARMACEUTICO | VENDEDOR
  email     String?
  phone     String?
  active    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  purchases Purchase[]
  inventoryCounts InventoryCount[]
  auditLogs AuditLog[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  inventoryMovements InventoryMovement[]
  controlledLogs     ControlledLog[]
  returns            Return[]
  quotations         Quotation[]
}

// CATEGORÍAS DE MEDICAMENTOS
model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  products    Product[]
  promotions  Promotion[]
}

// PROVEEDORES / DISTRIBUIDORAS
model Supplier {
  id          String     @id @default(cuid())
  name        String
  taxId       String? // NIT / RUC / RFC
  contactName String?
  phone       String?
  email       String?
  address     String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  products    Product[]
  purchases   Purchase[]
}

// MEDICAMENTOS / PRODUCTOS
model Product {
  id                   String     @id @default(cuid())
  code                 String     @unique
  barcode              String?
  name                 String
  description          String?
  categoryId           String?
  category             Category?  @relation(fields: [categoryId], references: [id])
  supplierId           String?
  supplier             Supplier?  @relation(fields: [supplierId], references: [id])
  lab                  String? // Laboratorio fabricante
  activeIngredient     String? // Principio activo
  presentation         String? // Caja x 30 tab, Frasco 120ml, etc.
  concentration        String? // 500mg, 10mg/ml
  purchasePrice        Float      @default(0)
  salePrice            Float      @default(0)
  minStock             Int        @default(5)
  requiresPrescription Boolean     @default(false)
  controlled           Boolean     @default(false) // Medicamento controlado
  location             String? // Ubicación en estante (A1, B3...)
  active               Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  lots                 Lot[]
  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]
  inventoryMovements   InventoryMovement[]
  controlledLogs       ControlledLog[]
  quotationItems       QuotationItem[]
  promotions           Promotion[]
  interactionsA        DrugInteraction[] @relation("interactionA")
  interactionsB        DrugInteraction[] @relation("interactionB")
  countItems           InventoryCountItem[]
}

// INTERACCIONES MEDICAMENTOSAS (alertas clínicas en el POS)
model DrugInteraction {
  id          String   @id @default(cuid())
  productAId  String
  productA    Product  @relation("interactionA", fields: [productAId], references: [id])
  productBId  String
  productB    Product  @relation("interactionB", fields: [productBId], references: [id])
  severity    String   @default("MODERADA") // LEVE | MODERADA | GRAVE
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// CONTEO FÍSICO DE INVENTARIO (tomas de inventario con ajuste al kardex)
model InventoryCount {
  id          String               @id @default(cuid())
  countNumber String               @unique
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  status      String               @default("EN_PROCESO") // EN_PROCESO | APLICADO | CANCELADO
  notes       String?
  totalLots   Int                  @default(0)
  differences Int                  @default(0)
  createdAt   DateTime             @default(now())
  appliedAt   DateTime?
  items       InventoryCountItem[]
}

model InventoryCountItem {
  id          String          @id @default(cuid())
  countId     String
  count       InventoryCount  @relation(fields: [countId], references: [id], onDelete: Cascade)
  lotId       String
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  productName String
  lotNumber   String
  systemQty   Int
  countedQty  Int?
  difference  Int?
}

// BITÁCORA DE AUDITORÍA (quién hizo qué)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String
  action    String   // LOGIN | LOGOUT | VENTA | ANULACION | COMPRA | PRODUCTO | USUARIO | CONTEO | CONFIG
  module    String
  detail    String?
  createdAt DateTime @default(now())
}

// LOTES DE INVENTARIO (trazabilidad y vencimientos, despacho FEFO)
model Lot {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  lotNumber    String
  expiryDate   DateTime
  quantity     Int        @default(0)
  purchasePrice Float     @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  saleItems    SaleItem[]
}

// CLIENTES
model Customer {
  id        String     @id @default(cuid())
  document  String? // Cédula / DNI / RUC
  name      String
  phone     String?
  email     String?
  address   String?
  birthDate DateTime?
  points    Int      @default(0) // Puntos de lealtad (1 pt por cada $10 en compras)
  notes     String?
  createdAt DateTime   @default(now())
  sales     Sale[]
}

// VENTAS / FACTURAS
model Sale {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  customerName  String? // Nombre capturado al momento de la venta
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  subtotal      Float      @default(0)
  tax           Float      @default(0)
  discount      Float      @default(0)
  total         Float      @default(0)
  paymentMethod String     @default("EFECTIVO") // EFECTIVO | TARJETA | TRANSFERENCIA | QR | MIXTO
  amountPaid    Float      @default(0)
  paidCash      Float      @default(0) // desglose de pagos mixtos
  paidCard      Float      @default(0)
  paidTransfer  Float      @default(0)
  change        Float      @default(0)
  pointsEarned  Int        @default(0) // puntos ganados en esta venta
  pointsRedeemed Int       @default(0) // puntos canjeados como descuento
  status        String     @default("COMPLETADA") // COMPLETADA | ANULADA
  voidReason    String?
  notes         String?
  createdAt     DateTime   @default(now())
  items         SaleItem[]
  prescriptions Prescription[]
  returns       Return[]
}

// DETALLE DE VENTA
model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  lotId       String?
  lot         Lot?     @relation(fields: [lotId], references: [id])
  productName String // Snapshot del nombre
  lotNumber   String?
  quantity    Int
  unitPrice   Float
  subtotal    Float
}

// COMPRAS / ÓRDENES DE COMPRA A PROVEEDORES
model Purchase {
  id          String         @id @default(cuid())
  orderNumber String         @unique
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  total       Float          @default(0)
  status      String         @default("PENDIENTE") // PENDIENTE | RECIBIDA | CANCELADA
  notes       String?
  createdAt   DateTime       @default(now())
  receivedAt  DateTime?
  items       PurchaseItem[]
}

// DETALLE DE COMPRA
model PurchaseItem {
  id         String    @id @default(cuid())
  purchaseId String
  purchase   Purchase  @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Float
  lotNumber  String?
  expiryDate DateTime?
}

// RECETAS MÉDICAS (control de medicamentos que requieren receta)
model Prescription {
  id            String   @id @default(cuid())
  folio         String   @unique
  doctorName    String
  doctorLicense String? // Registro/cédula profesional
  patientName   String
  saleId        String?
  sale          Sale?    @relation(fields: [saleId], references: [id])
  prescriptionDate DateTime?
  status        String   @default("REGISTRADA") // REGISTRADA | PARCIAL | DISPENSADA
  notes         String?
  createdAt     DateTime @default(now())
  items         PrescriptionItem[]
}

// ITEMS PRESCRITOS EN LA RECETA (medicamentos indicados)
model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  productId      String?
  productName    String
  quantity       Int          @default(1)
  dispensed      Boolean      @default(false)
}

// CONFIGURACIÓN DE LA FARMACIA (clave-valor)
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// CAJA - SESIONES DE CAJA (turnos con arqueo)
model CashSession {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  openingAmount  Float          @default(0)
  closingAmount  Float? // efectivo contado al cerrar
  expectedAmount Float? // esperado: apertura + ventas en efectivo + ingresos - retiros
  difference     Float?
  status         String         @default("ABIERTA") // ABIERTA | CERRADA
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  notes          String?
  movements      CashMovement[]
}

// MOVIMIENTOS DE CAJA (ingresos/retiros de efectivo, ventas)
model CashMovement {
  id            String      @id @default(cuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  type          String // INGRESO | RETIRO | VENTA
  amount        Float
  reason        String
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
}

// KARDEX - MOVIMIENTOS DE INVENTARIO (trazabilidad completa)
model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  lotNumber String?
  type      String // ENTRADA | SALIDA | AJUSTE | MERMA
  quantity  Int // siempre positivo; el tipo indica la dirección
  reason    String
  reference String? // FV-00001, OC-0002, DEV-00001...
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// LIBRO OFICIAL DE MEDICAMENTOS CONTROLADOS
model ControlledLog {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  lotNumber   String
  operation   String // ENTRADA | SALIDA
  quantity    Int
  doctorName  String? // para salidas con receta
  patientName String?
  folio       String? // folio de receta
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

// COTIZACIONES PARA CLIENTES
model Quotation {
  id           String          @id @default(cuid())
  quoteNumber  String          @unique
  customerId   String?
  customerName String?
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  total        Float           @default(0)
  status       String          @default("PENDIENTE") // PENDIENTE | ACEPTADA | RECHAZADA | VENCIDA
  validUntil   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  items        QuotationItem[]
}

// DETALLE DE COTIZACIÓN
model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Float
  subtotal    Float
}

// PROMOCIONES Y DESCUENTOS
model Promotion {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        String    @default("PORCENTAJE") // PORCENTAJE | MONTO
  value       Float // 10 = 10% o $10 según tipo
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// DEVOLUCIONES DE CLIENTES
model Return {
  id           String   @id @default(cuid())
  returnNumber String   @unique
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  amount       Float    @default(0)
  reason       String
  restocked    Boolean  @default(true)
  createdAt    DateTime @default(now())
}
